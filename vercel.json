{
  "version": 2,
  "rewrites": [
    {"source":"/about-us","destination":"/index.html"},
    {"source":"/properties","destination":"/index.html"},
    {"source":"/properties/:slug","destination":"/index.html"},
    {"source":"/services","destination":"/index.html"},
    {"source":"/blog","destination":"/index.html"},
    {"source":"/blog/:slug","destination":"/index.html"},
    {"source":"/agents","destination":"/index.html"},
    {"source":"/contact","destination":"/index.html"},
    {"source":"/gallery","destination":"/index.html"},
    {"source":"/404","destination":"/index.html"}
  ],
  "headers": [{"source":"/(.*)","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}
  ]}]
}
